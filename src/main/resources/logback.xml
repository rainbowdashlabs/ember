<configuration>
    <timestamp key="runTimestamp" datePattern="yyyy-MM-dd_HH-mm-ss"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/ember.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/ember-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="DATABASE" class="dev.chojo.ember.feature.system.service.DatabaseLogAppender"/>

    <appender name="PROBLEMS" class="dev.chojo.ember.feature.system.service.ProblemLogAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
    </appender>

    <!-- Application -->
    <logger name="dev.chojo.ember" level="TRACE" />

    <!-- Jetty / Eclipse -->
    <logger name="org.eclipse.jetty" level="WARN" />

    <!-- Javalin -->
    <logger name="io.javalin" level="INFO" />

    <!-- HikariCP -->
    <logger name="com.zaxxer.hikari" level="INFO" />

    <!-- SADU -->
    <logger name="de.chojo.sadu" level="INFO" />

    <!-- Jackson -->
    <logger name="tools.jackson" level="WARN" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
        <appender-ref ref="PROBLEMS" />
        <appender-ref ref="DATABASE" />
    </root>
</configuration>
