{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "constraints": {
    "java": "25"
  },
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Auto-merge minor and patch updates (non-major)",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "platformAutomerge": true
    },
    {
      "description": "Major updates require PR and manual approval",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Group all non-major dependency updates",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Group all major updates per package manager",
      "matchUpdateTypes": ["major"],
      "groupName": "major updates"
    },
    {
      "description": "Every PostgreSQL image moves in one PR, so the compose files, the installer, the hosting help and the tests never run different versions",
      "matchDatasources": ["docker"],
      "matchDepNames": ["postgres"],
      "groupName": "postgres",
      "groupSlug": "postgres"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "PostgreSQL images named outside a compose file",
      "managerFilePatterns": [
        "/^frontend/public/install\\.sh$/",
        "/^frontend/src/i18n/de-DE\\.helpcenter\\.ts$/",
        "/^src/test/java/dev/chojo/ember/TestContainers\\.java$/"
      ],
      "matchStrings": ["postgres:(?<currentValue>\\d[^\\s\"'`]*)"],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
