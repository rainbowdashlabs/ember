{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "constraints": {
    "java": "25"
  },
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Auto-merge minor and patch updates (non-major)",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "platformAutomerge": true
    },
    {
      "description": "Major updates require PR and manual approval",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Group all non-major dependency updates",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Group all major updates per package manager",
      "matchUpdateTypes": ["major"],
      "groupName": "major updates"
    },
    {
      "description": "Every PostgreSQL image moves in one PR, so the compose files, the installer, the hosting help and the tests never run different versions",
      "matchDatasources": ["docker"],
      "matchDepNames": ["postgres"],
      "groupName": "postgres",
      "groupSlug": "postgres"
    },
    {
      "description": "The release workflow's wait action is pinned to a reviewed release commit. A digest update would follow the action's default branch instead, so it is moved only by hand after reviewing the new release",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["lewagon/wait-on-check-action"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "PostgreSQL images named outside a compose file",
      "managerFilePatterns": [
        "/^frontend/public/install\\.sh$/",
        "/^frontend/src/i18n/de-DE\\.helpcenter\\.ts$/",
        "/^src/test/java/dev/chojo/ember/TestContainers\\.java$/"
      ],
      "matchStrings": ["postgres:(?<currentValue>\\d[^\\s\"'`]*)"],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Images the storage backend tests start as containers",
      "managerFilePatterns": ["/^src/test/java/.+/storage/backend/.+Test\\.java$/"],
      "matchStrings": [
        "GenericContainer<>\\(\\s*\"(?<depName>[^\":@\\s]+):(?<currentValue>[^\"@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The Typst version CI downloads",
      "managerFilePatterns": ["/^\\.github/workflows/verify\\.yml$/"],
      "matchStrings": ["TYPST_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "typst/typst",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
